# skywaved as a systemd user service: the agent runs as you, with your
# `claude` login and ~/.claude. See README.md, "Running it as a service".
#
#   scripts/deploy/deploy.sh <ssh-host>   # builds, copies and starts it
#
# Or by hand, with the binary in ~/.local/bin/skywaved:
#
#   cp contrib/systemd/skywaved.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now skywaved
#   loginctl enable-linger "$USER"   # keep it running while you are logged out
#
# The unit sets no environment: the service gets the user manager's, which
# reads ~/.config/environment.d/*.conf. Put PATH there, so the agent and the
# shell runner find `claude`, cargo and the rest. Change anything else with
# `systemctl --user edit skywaved`: that drop-in
# (~/.config/systemd/user/skywaved.service.d/override.conf) is yours, and a
# deploy, which replaces only this file, leaves it alone.

[Unit]
Description=Skywave server daemon

[Service]
ExecStart=%h/.local/bin/skywaved serve
# Reopens log_file (logrotate); without one, logs go to the journal.
ExecReload=/bin/kill -HUP $MAINPID
# `skywaved stop` exits 0, so it stays stopped; `skywaved restart` starts
# serve again in the same process.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
