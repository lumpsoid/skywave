<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The core's sync engine talks to the server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkWatcher: nudge a reconnect when a network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scanning the pairing QR code (D20); the scanner asks for it when opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Typing the details or opening the link pairs without a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Approval notifications (API 33+); asked when a session is first opened. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Stay connected" (A15): the opt-in foreground service, type specialUse
         on API 34+ (see StayConnectedService for why). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".SkywaveApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- skywave://pair?addr=…&code=…&fp=… (what the pairing QR code holds) prefills pairing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skywave" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Holds the core's link up while the user chose to stay connected (A15).
             Never exported; started only from the app in the foreground. -->
        <service
            android:name=".background.StayConnectedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled persistent connection to the user's own self-hosted Skywave server, so approval requests from coding agents are notified within seconds." />
        </service>
        <!-- Hands downloaded blobs to other apps (share, open with), read-only
             and only to an app granted one URI; paths in blob_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.blobs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/blob_paths" />
        </provider>
        <!-- The QR scanner turns with the device instead of staying in the
             library's default landscape. This lifts a fixed orientation, which
             is what the DiscouragedApi check asks for, so it is ignored here. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="unspecified"
            tools:ignore="DiscouragedApi"
            tools:replace="screenOrientation" />
    </application>

</manifest>
