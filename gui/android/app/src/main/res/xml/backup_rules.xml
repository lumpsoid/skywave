<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: nothing is backed up. The core's data dir under
     getApplicationSupportDirectory() (filesDir on Android) holds the device
     key (D22); excluding every domain keeps it on the device, as the Kotlin
     head does. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
